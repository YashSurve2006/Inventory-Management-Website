# Copy to backend/.env and replace every placeholder with local values.
NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=inventory_app
DB_PASSWORD=replace_with_a_unique_local_password
DB_NAME=inventorydb
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
DEMO_ADMIN_PASSWORD=replace_with_a_unique_demo_admin_password
DEMO_STAFF_PASSWORD=replace_with_a_unique_demo_staff_password
# Destructive reset is disabled by default. Enable only for a disposable dev database.
RESET_DEMO_DATA=false
